+/* The longest run of literal data that is sent as one uncompressed token.
+ * The sender uses literal_chunk_size, which parse_arguments() sets to this,
+ * or to less with a small --max-alloc.  write_buf() copies a token into the
+ * output buffer in one piece, so the sender's buffer holds two of them, and
+ * it can become one MSG_DATA frame, whose length field has 24 bits. */
+#define LITERAL_CHUNK_SIZE (8*1024*1024)
+#if LITERAL_CHUNK_SIZE > (1 << 23)
+#error "LITERAL_CHUNK_SIZE must be at most 8 MiB"
+#endif
 #define MAX_MAP_SIZE (256*1024)
 #define IO_BUFFER_SIZE (32*1024)
 #define MAX_BLOCK_SIZE ((int32)1 << 17)
